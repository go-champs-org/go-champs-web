  "scripts": {
    "start": "env-cmd -f env.local.js craco --openssl-legacy-provider start",
    "build": "env-cmd -f env.prod.js craco --openssl-legacy-provider build",
    "build:adm": "env-cmd -f env.prod.js craco --openssl-legacy-provider build",
    "build:staging": "env-cmd -f env.staging.js craco --openssl-legacy-provider build",
    "test": "craco test",
    "test:ci": "cross-env CI=true craco test",
    "test:e2e": "cypress run",
    "test:e2e:headless": "xvfb-run -a cypress run",
    "test:e2e:local": "env-cmd -f env.local.js xvfb-run -a cypress run",
    "test:e2e:staging": "env-cmd -f env.staging.js xvfb-run -a cypress run",
    "test:e2e:prod": "env-cmd -f env.prod.js xvfb-run -a cypress run",
    "test:e2e:open": "cypress open",
    "eject": "react-scripts eject",
    "lint": "prettier --single-quote --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "lint:check": "prettier --single-quote --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "validate-colors": "node scripts/validate-colors.js",
    "validate-colors:generate": "node scripts/validate-colors.js generate"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
