{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gochamps-public-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // No custom domain: this Worker is reached through the CMS Worker's PUBLIC
  // service binding. workers.dev stays on so staging can be smoke-tested
  // directly, bypassing the edge routing.
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  // API_HOST is read by the server at request time, so it belongs here.
  //
  // NEXT_PUBLIC_* variables do NOT: Next inlines them into the bundle during
  // `next build`, so setting one here has no effect. NEXT_PUBLIC_CMS_URL must
  // be supplied to the build instead (Workers Builds: Settings > Build >
  // build variables) as https://new-staging.go-champs.com — without it,
  // src/config/cms.ts falls back to production's https://go-champs.com.
  //
  // The analytics keys (NEXT_PUBLIC_GA_ID, NEXT_PUBLIC_AMPLITUDE_API_KEY) are
  // deliberately unset — analytics stays off on new-staging.
  "vars": {
    "API_HOST": "https://api-staging.go-champs.com/"
  }
}
