{
  "name": "go-champs-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "start": "turbo run start",
    "test": "turbo run test",
    "test:ci": "turbo run test:ci",
    "lint:check": "turbo run lint:check"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "react-qr-code": "2.0.7",
      "babel-preset-jest@26.6.2>babel-preset-current-node-syntax": "1.0.1"
    },
    "packageExtensions": {
      "react-datetime@*": {
        "peerDependencies": { "@types/react": "*" }
      },
      "react-dnd@*": {
        "peerDependencies": { "@types/react": "*" }
      },
      "react-dnd-html5-backend@*": {
        "peerDependencies": { "@types/react": "*" }
      },
      "react-dropzone@*": {
        "peerDependencies": { "@types/react": "*" }
      },
      "react-final-form@*": {
        "peerDependencies": { "@types/react": "*" }
      },
      "react-final-form-arrays@*": {
        "peerDependencies": { "@types/react": "*" }
      },
      "react-i18next@*": {
        "peerDependencies": { "@types/react": "*" }
      },
      "react-image-crop@*": {
        "peerDependencies": { "@types/react": "*" }
      },
      "react-markdown@*": {
        "peerDependencies": { "@types/react": "*" }
      },
      "react-qr-code@*": {
        "peerDependencies": { "@types/react": "*" }
      }
    }
  }
}
